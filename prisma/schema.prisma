datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

//////////////////////
// ENUMS
//////////////////////

enum FormStatus {
  DRAFT
  PUBLISHED
}

enum FieldType {
  TEXT
  SELECT      
}

enum Role {
  UNVERIFIED
  USER
  ADMIN
}

//////////////////////
// MODELS
//////////////////////


model User {
  userId       String   @id @default(cuid())
  email        String   @unique
  role         Role     @default(UNVERIFIED) // starts as UNVERIFIED until OTP confirmed


  otpCode      String?    
  otpExpiresAt DateTime?

  refreshToken String?

  createdAt    DateTime @default(now())


}


model Form {
  formId         String     @id @default(cuid())
  yourName    String
  yourSpouseName    String
  status         FormStatus @default(DRAFT)

  revealText    String?   // ✅ message after submit
  revealImage   String?  

  responseCount  Int        @default(0) // ✅ total submissions

  fields         Field[]
  responses      Response[]

  createdAt      DateTime   @default(now())

}


model Field {
  fieldId   String    @id @default(cuid())
  label     String
  type      FieldType
  order     Int

  formId    String
  form      Form      @relation(fields: [formId], references: [formId])
  correctAnswer  String?

  options   Option[]     // ✅ OPTIONS ONLY FOR CHOICE FIELDS
  values    Value[]      // ✅ required reverse relation
}

model Option {
  optionId  String   @id @default(cuid())
  label     String

  fieldId   String
  field     Field    @relation(fields: [fieldId], references: [fieldId])
}

model Response {
  responseId        String   @id @default(cuid())

  formId            String
  form              Form     @relation(fields: [formId], references: [formId])

  submissionScore   Int      @default(0) // ✅ score per submission

  values            Value[]

  createdAt         DateTime @default(now())
}

model Value {
  valueId    String   @id @default(cuid())

  responseId String
  response   Response @relation(fields: [responseId], references: [responseId])

  fieldId    String
  field      Field    @relation(fields: [fieldId], references: [fieldId])

  value      String
}
